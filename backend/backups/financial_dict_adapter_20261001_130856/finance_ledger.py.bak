from financial_routing.services import calculate_fee


def calculate_withdraw_fee(amount):

    fee, _ = calculate_fee(
        amount,
        "WITHDRAWAL"
    )

    return fee


def calculate_transfer_fee(amount):

    fee, _ = calculate_fee(
        amount,
        "TRANSFER_INTERNAL"
    )

    return fee


def calculate_mobile_money_fee(amount):

    fee, _ = calculate_fee(
        amount,
        "TRANSFER_MOBILE_MONEY"
    )

    return fee


def calculate_visa_fee(amount):

    fee, _ = calculate_fee(
        amount,
        "TRANSFER_VISA"
    )

    return fee


def calculate_wenze_fee(amount):

    fee, _ = calculate_fee(
        amount,
        "WENZE"
    )

    return fee


def create_ledger_entry(
    wallet,
    operation,
    amount,
    currency,
    reference
):

    from finance.models import FinancialLedger

    return FinancialLedger.objects.create(
        wallet=wallet,
        transaction_type=operation,
        amount=amount,
        currency=currency,
        reference=reference
    )


def calculate_withdrawal_fee(amount):
    from decimal import Decimal
    from financial_routing.services import calculate_fee

    result = calculate_fee(
        amount=Decimal(str(amount)),
        fee_type="WITHDRAWAL",
    )

    if isinstance(result, (tuple, list)):

        if len(result) == 5:
            return Decimal(str(result[3]))

        if len(result) == 2:
            return Decimal(str(result[0]))

    raise RuntimeError(
        "Retour inattendu du moteur financier central."
    )
