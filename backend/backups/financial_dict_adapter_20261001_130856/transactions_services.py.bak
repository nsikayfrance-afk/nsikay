from decimal import Decimal
from django.db import transaction

from financial_routing.services import calculate_fee
from .models import Transaction


FEE_TYPE_MAP = {
    "transfer": "TRANSFER_INTERNAL",
    "withdrawal": "WITHDRAWAL",
}


def _extract_fee_result(result):

    if not isinstance(result, (tuple, list)):
        raise RuntimeError(
            "Le moteur financier central retourne un format invalide."
        )

    if len(result) == 5:
        amount, fee_type, percentage, fee_amount, net_amount = result

        return (
            Decimal(str(amount)),
            fee_type,
            Decimal(str(percentage)),
            Decimal(str(fee_amount)),
            Decimal(str(net_amount)),
        )

    if len(result) == 2:
        fee_amount, net_amount = result

        return (
            None,
            None,
            None,
            Decimal(str(fee_amount)),
            Decimal(str(net_amount)),
        )

    raise RuntimeError(
        f"Format de retour financier inattendu : {len(result)} valeurs."
    )


def calculate_fees(amount, transaction_type):

    amount = Decimal(str(amount))

    fee_type = FEE_TYPE_MAP.get(transaction_type)

    if not fee_type:
        return Decimal("0.00"), amount

    result = calculate_fee(
        amount=amount,
        fee_type=fee_type,
    )

    _, _, _, fee_amount, net_amount = _extract_fee_result(result)

    return fee_amount, net_amount


@transaction.atomic
def process_transaction(
    sender,
    receiver,
    amount,
    currency,
    transaction_type="transfer",
    reference=None,
    partner=None,
):

    amount = Decimal(str(amount))

    if amount <= 0:
        raise ValueError(
            "Le montant doit etre superieur a zero."
        )

    fee, net_amount = calculate_fees(
        amount,
        transaction_type,
    )

    transaction_obj = Transaction.objects.create(
        sender=sender,
        receiver=receiver,
        partner=partner,
        amount=net_amount,
        currency=currency,
        transaction_type=transaction_type,
        status="completed",
        reference=reference,
    )

    return {
        "transaction": transaction_obj,
        "amount": amount,
        "fee": fee,
        "net_amount": net_amount,
    }
