<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Commande WENZE</title>
</head>
<body>
    <h1>Commande enregistrée</h1>
    <p>Référence : <strong>{{ order.reference }}</strong></p>
    <p>Produit : {{ order.product.name }}</p>
    <p>Quantité : {{ order.quantity }}</p>
    <p>Total : {{ order.total_amount }} {{ order.currency }}</p>
    <p>Statut : {{ order.get_status_display }}</p>
    <p>Commission commerciale WENZE : 0 %</p>
</body>
</html>
