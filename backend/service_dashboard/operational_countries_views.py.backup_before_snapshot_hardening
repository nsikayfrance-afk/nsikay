from django.contrib import messages
from django.contrib.auth.decorators import user_passes_test
from django.shortcuts import redirect, render

from service_control.models import CountryServiceStatus
from service_dashboard.models import OperationalCountryConfigurationLog


MAX_OPERATIONAL_COUNTRIES = 240


def _is_nsikay_admin(user):
    if not user or not user.is_authenticated:
        return False

    username = str(user.username).strip().lower()

    if username == "constantdoriskayembe":
        return True

    return (
        user.is_superuser
        or user.groups.filter(
            name__in=[
                "Super Administrateur",
                "Administration Pays",
            ]
        ).exists()
    )


@user_passes_test(_is_nsikay_admin)
def operational_countries(request):

    countries = (
        CountryServiceStatus.objects
        .filter(is_primary=True)
        .order_by("country_name")
    )

    if request.method == "POST":

        selected_codes = {
            str(code).strip().upper()
            for code in request.POST.getlist("operational_countries")
            if str(code).strip()
        }

        selected_count = len(selected_codes)

        # ----------------------------------------------------
        # REGLE ABSOLUE : EXACTEMENT 240
        # ----------------------------------------------------

        if selected_count != MAX_OPERATIONAL_COUNTRIES:

            messages.error(
                request,
                (
                    f"Enregistrement refuse : {selected_count} pays "
                    f"selectionnes. NSIKAY exige exactement "
                    f"{MAX_OPERATIONAL_COUNTRIES} pays operationnels."
                )
            )

            return redirect("service_dashboard:operational_countries")

        # ----------------------------------------------------
        # VERIFICATION ISO3
        # ----------------------------------------------------

        valid_codes = set(
            countries.values_list(
                "country_code",
                flat=True
            )
        )

        invalid_codes = sorted(
            selected_codes - valid_codes
        )

        if invalid_codes:

            messages.error(
                request,
                (
                    "Enregistrement refuse : un ou plusieurs "
                    "codes ISO3 ne correspondent pas aux pays "
                    "principaux NSIKAY."
                )
            )

            return redirect("service_dashboard:operational_countries")

        # ----------------------------------------------------
        # CONTROLE DES 249 PAYS PRINCIPAUX
        # ----------------------------------------------------

        primary_count = countries.count()

        if primary_count != 249:

            messages.error(
                request,
                (
                    f"Structure inattendue : {primary_count} pays "
                    "principaux trouves au lieu de 249. "
                    "Aucune modification effectuee."
                )
            )

            return redirect("service_dashboard:operational_countries")

        # ----------------------------------------------------
        # MISE A JOUR EXCLUSIVE DE is_operational
        # ----------------------------------------------------

        countries.update(
            is_operational=False
        )

        countries.filter(
            country_code__in=selected_codes
        ).update(
            is_operational=True
        )

        # ----------------------------------------------------
        # VERIFICATION POST-ECRITURE
        # ----------------------------------------------------

        operational_count = countries.filter(
            is_operational=True
        ).count()

        if operational_count != MAX_OPERATIONAL_COUNTRIES:

            # Annulation de securite.
            countries.update(
                is_operational=False
            )

            messages.error(
                request,
                (
                    "Erreur de verification : le nombre final "
                    "de pays operationnels n'est pas egal a 240. "
                    "La modification a ete annulee."
                )
            )

            return redirect("service_dashboard:operational_countries")

        OperationalCountryConfigurationLog.objects.create(
            admin_user=str(request.user.username),
            selected_count=operational_count,
            selected_codes=",".join(
                sorted(selected_codes)
            ),
            action="configuration_240_pays",
        )

        messages.success(
            request,
            (
                "Configuration enregistree avec succes : "
                "240 pays sont maintenant operationnels pour NSIKAY."
            )
        )

        return redirect(
            "service_dashboard:operational_countries"
        )

    # --------------------------------------------------------
    # AFFICHAGE
    # --------------------------------------------------------

    operational_count = countries.filter(
        is_operational=True
    ).count()

    non_operational_count = (
        countries.count() - operational_count
    )

    context = {
        "countries": countries,
        "operational_count": operational_count,
        "non_operational_count": non_operational_count,
        "maximum_operational": MAX_OPERATIONAL_COUNTRIES,
        "selection_complete": (
            operational_count == MAX_OPERATIONAL_COUNTRIES
        ),
        "remaining_slots": max(
            0,
            MAX_OPERATIONAL_COUNTRIES - operational_count
        ),
    }

    return render(
        request,
        "service_dashboard/operational_countries.html",
        context
    )

from django.contrib import messages
from django.contrib.auth.decorators import login_required
from django.db import transaction
from django.shortcuts import redirect
from django.utils import timezone

from service_control.models import CountryServiceStatus
from .models import (
    OperationalCountryConfigurationLog,
    OperationalCountryConfigurationSnapshot,
)


@login_required
def rollback_last_configuration(request):
    if request.method != "POST":
        messages.error(
            request,
            "Le rollback doit être effectué par une requête POST."
        )
        return redirect("service_dashboard:operational_countries_history")

    with transaction.atomic():

        log = (
            OperationalCountryConfigurationLog.objects
            .select_for_update()
            .filter(
                action="configuration_officielle_240_pays",
                rolled_back=False,
            )
            .order_by("-created_at")
            .first()
        )

        if not log:
            messages.error(
                request,
                "Aucune configuration officielle annulable n'a été trouvée."
            )
            return redirect("service_dashboard:operational_countries_history")

        snapshot = (
            OperationalCountryConfigurationSnapshot.objects
            .select_for_update()
            .filter(configuration_log=log)
            .first()
        )

        if not snapshot:
            messages.error(
                request,
                "Le snapshot de la dernière configuration est introuvable."
            )
            return redirect("service_dashboard:operational_countries_history")

        countries = list(
            CountryServiceStatus.objects
            .select_for_update()
            .filter(is_primary=True)
        )

        if len(countries) != 249:
            raise ValueError(
                f"Rollback interrompu : {len(countries)} pays principaux "
                "au lieu de 249."
            )

        previous_codes = [
            code.strip().upper()
            for code in snapshot.previous_operational_codes.split(",")
            if code.strip()
        ]

        CountryServiceStatus.objects.filter(
            is_primary=True
        ).update(
            is_operational=False
        )

        if previous_codes:
            CountryServiceStatus.objects.filter(
                is_primary=True,
                country_code__in=previous_codes,
            ).update(
                is_operational=True
            )

        restored_count = CountryServiceStatus.objects.filter(
            is_primary=True,
            is_operational=True,
        ).count()

        if restored_count != snapshot.previous_operational_count:
            raise ValueError(
                "Rollback interrompu : le nombre de pays restaurés "
                f"({restored_count}) ne correspond pas au snapshot "
                f"({snapshot.previous_operational_count})."
            )

        log.rolled_back = True
        log.rolled_back_at = timezone.now()
        log.rolled_back_by = (
            request.user.get_username()
            if request.user.is_authenticated
            else "system"
        )
        log.rollback_reason = (
            "Annulation de la dernière configuration officielle "
            "des 240 pays."
        )
        log.save(
            update_fields=[
                "rolled_back",
                "rolled_back_at",
                "rolled_back_by",
                "rollback_reason",
            ]
        )

    messages.success(
        request,
        "La dernière configuration officielle des pays a été annulée."
    )

    return redirect("service_dashboard:operational_countries_history")

